{
    "_comment": "Logical metrics -> CPViewDB.dat (table, column). 'table' and 'column' are case-insensitive regexes tried in order; the first table that has a matching numeric column wins. CPView schemas differ between versions/JHF takes - use the Schema Explorer tab to see your gateway's real names and edit this file (no restart of the gateway side needed; restart cpview_server.py). unit: percent | bytes | kbytes | bits_per_sec | bytes_per_sec | packets_per_sec | count | per_sec | live: optional spec for `cpview -m` (R82 telemetry feed, used for recent data because R82 flushes the DB only every few hours). metric = metric-id regexes; where = {label: regex} filters; by = label keys naming the series (a key may be a regex like 'interface|device'); transform = '100-' or 'used_pct'. Live metric-ids are listed in the Schema Explorer.",
    "metrics": [
        {"id": "cpu_core_usage", "title": "CPU usage by core", "unit": "percent", "table": ["UM_CPU_ORDERED_TABLE", "UM_CPU.*TABLE", "CPU.*(TABLE|CORE)"], "column": ["^cpu_usage$", "^usage$", "cpu_?usage", "total_usage", "usage"], "live": {"metric": ["^system\\.cpu\\.utilization$"], "by": ["cpu"], "where": {"state": "idle"}, "transform": "100-"}},
        {"id": "cpu_user", "title": "CPU user", "unit": "percent", "agg": "avg", "table": ["UM_CPU_ORDERED_TABLE", "UM_CPU.*TABLE", "CPU"], "column": ["^cpu_user$", "^user$", "user"], "live": {"metric": ["^system\\.cpu\\.utilization$"], "by": ["cpu"], "where": {"state": "user"}}},
        {"id": "cpu_system", "title": "CPU system", "unit": "percent", "agg": "avg", "table": ["UM_CPU_ORDERED_TABLE", "UM_CPU.*TABLE", "CPU"], "column": ["^cpu_system$", "^system$", "^sys", "system"], "live": {"metric": ["^system\\.cpu\\.utilization$"], "by": ["cpu"], "where": {"state": "system"}}},
        {"id": "cpu_iowait", "title": "CPU iowait", "unit": "percent", "agg": "avg", "table": ["UM_CPU_ORDERED_TABLE", "UM_CPU.*TABLE", "CPU"], "column": ["^cpu_iowait$", "iowait", "io_wait", "wait"], "live": {"metric": ["^system\\.cpu\\.utilization$"], "by": ["cpu"], "where": {"state": "io ?wait"}}},
        {"id": "cpu_interrupts", "title": "CPU interrupts/sec", "unit": "per_sec", "table": ["UM_CPU_ORDERED_TABLE", "UM_CPU.*TABLE", "CPU"], "column": ["interrupts", "^int", "irq"], "live": {"metric": ["^system\\.cpu\\.interrupts$"], "by": ["cpu"]}},
        {"id": "mem_total", "title": "RAM total", "unit": "bytes", "table": ["UM_MEMORY$", "UM_STAT_UM_MEMORY", "MEMORY"], "column": ["^real_total$", "real.*total", "^total", "mem.*total"], "live": {"metric": ["^system\\.memory\\.limit$"]}},
        {"id": "mem_used", "title": "RAM used", "unit": "bytes", "table": ["UM_MEMORY$", "UM_STAT_UM_MEMORY", "MEMORY"], "column": ["^real_used$", "real.*used", "^used", "mem.*used"], "live": {"metric": ["^system\\.memory\\.usage$"], "where": {"state": "used"}}},
        {"id": "mem_free", "title": "RAM free", "unit": "bytes", "table": ["UM_MEMORY$", "UM_STAT_UM_MEMORY", "MEMORY"], "column": ["^real_free$", "real.*free", "^free", "mem.*free"], "live": {"metric": ["^system\\.memory\\.usage$"], "where": {"state": "free"}}},
        {"id": "swap_used", "title": "Swap used", "unit": "bytes", "table": ["UM_MEMORY$", "UM_STAT_UM_MEMORY", "MEMORY"], "column": ["^swap_used$", "swap.*used"], "live": {"metric": ["^system\\.paging\\.usage$"], "where": {"state": "used"}}},
        {"id": "disk_used_pct", "title": "Disk used %", "unit": "percent", "table": ["DISK", "PARTITION", "FILE_?SYSTEM", "HDD"], "column": ["used_?perc", "usage_?perc", "percent", "pct", "usage"], "live": {"metric": ["^system\\.filesystem\\.usage$", "filesystem.*usage", "disk.*usage"], "by": ["mountpoint"], "transform": "used_pct"}},
        {"id": "net_rx_bps", "title": "Interface receive", "unit": "bits_per_sec", "table": ["UM_IF_RX_STAT", "NETWORK.*INTERFACE", "INTERFACE", "NETWORK", "NIC", "IFACE"], "column": ["bits?_?per|bps", "bits_throughput", "rx_bits", "rx.*bps", "rx.*throughput", "in_bits", "rx_?bytes", "^rx", "in_?bytes"], "live": {"metric": ["network.*(bits|throughput|io)", "interface.*(bits|throughput)"], "where": {"direction": "receive|rx|in(bound)?"}, "by": ["interface|device"]}},
        {"id": "net_tx_bps", "title": "Interface transmit", "unit": "bits_per_sec", "table": ["UM_IF_TX_STAT", "NETWORK.*INTERFACE", "INTERFACE", "NETWORK", "NIC", "IFACE"], "column": ["bits?_?per|bps", "bits_throughput", "tx_bits", "tx.*bps", "tx.*throughput", "out_bits", "tx_?bytes", "^tx", "out_?bytes"], "live": {"metric": ["network.*(bits|throughput|io)", "interface.*(bits|throughput)"], "where": {"direction": "transmit|tx|out(bound)?"}, "by": ["interface|device"]}},
        {"id": "net_rx_pps", "title": "Interface packets in", "unit": "packets_per_sec", "table": ["UM_IF_RX_STAT", "NETWORK.*INTERFACE", "INTERFACE", "NETWORK", "NIC", "IFACE"], "column": ["packets_throughput", "rx_?packets", "rx_?pkts", "rx.*pps", "in_?packets", "in_?pkts"], "live": {"metric": ["network.*packets", "interface.*packets"], "where": {"direction": "receive|rx|in(bound)?"}, "by": ["interface|device"]}},
        {"id": "net_tx_pps", "title": "Interface packets out", "unit": "packets_per_sec", "table": ["UM_IF_TX_STAT", "NETWORK.*INTERFACE", "INTERFACE", "NETWORK", "NIC", "IFACE"], "column": ["packets_throughput", "tx_?packets", "tx_?pkts", "tx.*pps", "out_?packets", "out_?pkts"], "live": {"metric": ["network.*packets", "interface.*packets"], "where": {"direction": "transmit|tx|out(bound)?"}, "by": ["interface|device"]}},
        {"id": "net_rx_drops", "title": "Interface RX drops", "unit": "count", "table": ["UM_IF_RX_STAT", "UM_IF_ERR", "NETWORK.*INTERFACE", "INTERFACE", "NETWORK", "NIC", "IFACE"], "column": ["rx_?drop", "in_?drop", "drop"]},
        {"id": "conn_concurrent", "title": "Concurrent connections", "unit": "count", "table": ["fw_counters", "CONN", "FW_?STAT", "FIREWALL"], "column": ["concurrent", "^num_conn", "^connections$", "conns?$"], "live": {"metric": ["connections?\\.(concurrent|count|current|active)$", "concurrent.*conn"]}},
        {"id": "conn_tcp", "title": "TCP connections", "unit": "count", "table": ["fw_counters", "CONN", "FW_?STAT", "FIREWALL"], "column": ["^tcp_conn", "tcp.*conn", "^tcp$"]},
        {"id": "conn_udp", "title": "UDP connections", "unit": "count", "table": ["fw_counters", "CONN", "FW_?STAT", "FIREWALL"], "column": ["^udp_conn", "udp.*conn", "^udp$"]},
        {"id": "conn_other", "title": "Other connections", "unit": "count", "table": ["fw_counters", "CONN", "FW_?STAT", "FIREWALL"], "column": ["^other_conn", "other.*conn", "icmp.*conn"]},
        {"id": "conn_rate", "title": "Connection rate", "unit": "per_sec", "table": ["fw_counters", "CONN", "FW_?STAT", "FIREWALL"], "column": ["conn.*rate", "new_conn", "cps"], "live": {"metric": ["connections?\\.rate$", "new.*conn.*rate", "conn.*per.*sec"]}},
        {"id": "fw_drops", "title": "Dropped packets", "unit": "per_sec", "table": ["fw_counters", "FW_?STAT", "FIREWALL", "DROP"], "column": ["^dropped", "drop"], "live": {"metric": ["^system\\.traffic\\.dropped\\.rate$"]}},
        {"id": "fw_rejects", "title": "Rejected packets", "unit": "per_sec", "table": ["fw_counters", "FW_?STAT", "FIREWALL"], "column": ["^rejected", "reject"]},
        {"id": "corexl_cpu", "title": "CoreXL instance CPU", "unit": "percent", "table": ["COREXL.*INSTANCE", "COREXL", "FW_INSTANCE", "MULTIK"], "column": ["cpu_usage", "usage", "cpu"], "live": {"metric": ["corexl.*(cpu|utilization)"], "by": ["instance|id|cpu"]}},
        {"id": "corexl_conns", "title": "CoreXL instance connections", "unit": "count", "table": ["COREXL.*INSTANCE", "COREXL", "FW_INSTANCE", "MULTIK"], "column": ["^connections$", "^conn", "concurrent"], "live": {"metric": ["corexl.*conn"], "by": ["instance|id"]}}
    ]
}
