{
    "_comment": "Logical metrics -> CPViewDB.dat (table, column). 'table' and 'column' are case-insensitive regexes tried in order; the first table that has a matching numeric column wins. CPView schemas differ between versions/JHF takes - use the Schema Explorer tab to see your gateway's real names and edit this file (no restart of the gateway side needed; restart cpview_server.py). unit: percent | bytes | kbytes | bits_per_sec | bytes_per_sec | packets_per_sec | count | per_sec",
    "metrics": [
        {"id": "cpu_core_usage",  "title": "CPU usage by core",   "unit": "percent",
         "table": ["UM_CPU_ORDERED_TABLE", "UM_CPU.*TABLE", "CPU.*(TABLE|CORE)"],
         "column": ["^cpu_usage$", "^usage$", "cpu_?usage", "total_usage", "usage"]},
        {"id": "cpu_user",        "title": "CPU user",            "unit": "percent", "agg": "avg",
         "table": ["UM_CPU_ORDERED_TABLE", "UM_CPU.*TABLE", "CPU"],
         "column": ["^cpu_user$", "^user$", "user"]},
        {"id": "cpu_system",      "title": "CPU system",          "unit": "percent", "agg": "avg",
         "table": ["UM_CPU_ORDERED_TABLE", "UM_CPU.*TABLE", "CPU"],
         "column": ["^cpu_system$", "^system$", "^sys", "system"]},
        {"id": "cpu_iowait",      "title": "CPU iowait",          "unit": "percent", "agg": "avg",
         "table": ["UM_CPU_ORDERED_TABLE", "UM_CPU.*TABLE", "CPU"],
         "column": ["^cpu_iowait$", "iowait", "io_wait", "wait"]},
        {"id": "cpu_interrupts",  "title": "CPU interrupts/sec",  "unit": "per_sec",
         "table": ["UM_CPU_ORDERED_TABLE", "UM_CPU.*TABLE", "CPU"],
         "column": ["interrupts", "^int", "irq"]},

        {"id": "mem_total",       "title": "RAM total",           "unit": "bytes",
         "table": ["UM_MEMORY$", "UM_STAT_UM_MEMORY", "MEMORY"],
         "column": ["^real_total$", "real.*total", "^total", "mem.*total"]},
        {"id": "mem_used",        "title": "RAM used",            "unit": "bytes",
         "table": ["UM_MEMORY$", "UM_STAT_UM_MEMORY", "MEMORY"],
         "column": ["^real_used$", "real.*used", "^used", "mem.*used"]},
        {"id": "mem_free",        "title": "RAM free",            "unit": "bytes",
         "table": ["UM_MEMORY$", "UM_STAT_UM_MEMORY", "MEMORY"],
         "column": ["^real_free$", "real.*free", "^free", "mem.*free"]},
        {"id": "swap_used",       "title": "Swap used",           "unit": "bytes",
         "table": ["UM_MEMORY$", "UM_STAT_UM_MEMORY", "MEMORY"],
         "column": ["^swap_used$", "swap.*used"]},

        {"id": "disk_used_pct",   "title": "Disk used %",         "unit": "percent",
         "table": ["DISK", "PARTITION", "FILE_?SYSTEM", "HDD"],
         "column": ["used_?perc", "usage_?perc", "percent", "pct", "usage"]},

        {"id": "net_rx_bps",      "title": "Interface receive",   "unit": "bits_per_sec",
         "table": ["UM_IF_RX_STAT", "NETWORK.*INTERFACE", "INTERFACE", "NETWORK", "NIC", "IFACE"],
         "column": ["bits?_?per|bps", "throughput", "rx_bits", "rx.*bps", "rx.*throughput", "in_bits", "rx_?bytes", "^rx", "in_?bytes"]},
        {"id": "net_tx_bps",      "title": "Interface transmit",  "unit": "bits_per_sec",
         "table": ["UM_IF_TX_STAT", "NETWORK.*INTERFACE", "INTERFACE", "NETWORK", "NIC", "IFACE"],
         "column": ["bits?_?per|bps", "throughput", "tx_bits", "tx.*bps", "tx.*throughput", "out_bits", "tx_?bytes", "^tx", "out_?bytes"]},
        {"id": "net_rx_pps",      "title": "Interface packets in",  "unit": "packets_per_sec",
         "table": ["UM_IF_RX_STAT", "NETWORK.*INTERFACE", "INTERFACE", "NETWORK", "NIC", "IFACE"],
         "column": ["packets?_?per|pps", "packets|pkts", "rx_?packets", "rx_?pkts", "rx.*pps", "in_?packets", "in_?pkts"]},
        {"id": "net_tx_pps",      "title": "Interface packets out", "unit": "packets_per_sec",
         "table": ["UM_IF_TX_STAT", "NETWORK.*INTERFACE", "INTERFACE", "NETWORK", "NIC", "IFACE"],
         "column": ["packets?_?per|pps", "packets|pkts", "tx_?packets", "tx_?pkts", "tx.*pps", "out_?packets", "out_?pkts"]},
        {"id": "net_rx_drops",    "title": "Interface RX drops",  "unit": "count",
         "table": ["UM_IF_RX_STAT", "UM_IF_ERR", "NETWORK.*INTERFACE", "INTERFACE", "NETWORK", "NIC", "IFACE"],
         "column": ["rx_?drop", "in_?drop", "drop"]},

        {"id": "conn_concurrent", "title": "Concurrent connections", "unit": "count",
         "table": ["fw_counters", "CONN", "FW_?STAT", "FIREWALL"],
         "column": ["concurrent", "^num_conn", "^connections$", "conns?$"]},
        {"id": "conn_tcp",        "title": "TCP connections",     "unit": "count",
         "table": ["fw_counters", "CONN", "FW_?STAT", "FIREWALL"],
         "column": ["^tcp_conn", "tcp.*conn", "^tcp$"]},
        {"id": "conn_udp",        "title": "UDP connections",     "unit": "count",
         "table": ["fw_counters", "CONN", "FW_?STAT", "FIREWALL"],
         "column": ["^udp_conn", "udp.*conn", "^udp$"]},
        {"id": "conn_other",      "title": "Other connections",   "unit": "count",
         "table": ["fw_counters", "CONN", "FW_?STAT", "FIREWALL"],
         "column": ["^other_conn", "other.*conn", "icmp.*conn"]},
        {"id": "conn_rate",       "title": "Connection rate",     "unit": "per_sec",
         "table": ["fw_counters", "CONN", "FW_?STAT", "FIREWALL"],
         "column": ["conn.*rate", "new_conn", "cps"]},

        {"id": "fw_drops",        "title": "Dropped packets",     "unit": "per_sec",
         "table": ["fw_counters", "FW_?STAT", "FIREWALL", "DROP"],
         "column": ["^dropped", "drop"]},
        {"id": "fw_rejects",      "title": "Rejected packets",    "unit": "per_sec",
         "table": ["fw_counters", "FW_?STAT", "FIREWALL"],
         "column": ["^rejected", "reject"]},

        {"id": "corexl_cpu",      "title": "CoreXL instance CPU", "unit": "percent",
         "table": ["COREXL.*INSTANCE", "COREXL", "FW_INSTANCE", "MULTIK"],
         "column": ["cpu_usage", "usage", "cpu"]},
        {"id": "corexl_conns",    "title": "CoreXL instance connections", "unit": "count",
         "table": ["COREXL.*INSTANCE", "COREXL", "FW_INSTANCE", "MULTIK"],
         "column": ["^connections$", "^conn", "concurrent"]}
    ]
}
